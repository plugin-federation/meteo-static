{
  "tools": [
    {
      "name": "list_cities",
      "description": "List all supported cities for weather queries.\n\nReturns display names that can be used directly with get_weather and get_forecast.\n",
      "inputSchema": {
        "properties": {},
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "result": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "result"
        ],
        "type": "object"
      }
    },
    {
      "name": "get_weather",
      "description": "Get current weather for a city.\n\nArgs:\n    city: City key or display name (e.g. 'tokyo', 'Tokyo', 'New York').\n",
      "inputSchema": {
        "properties": {
          "city": {
            "type": "string"
          }
        },
        "required": [
          "city"
        ],
        "type": "object"
      },
      "outputSchema": {
        "properties": {
          "city": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "temp_c": {
            "type": "number"
          },
          "feels_like_c": {
            "type": "number"
          },
          "humidity_pct": {
            "type": "integer"
          },
          "wind_kph": {
            "type": "number"
          },
          "condition": {
            "type": "string"
          },
          "precip_mm": {
            "type": "number"
          }
        },
        "required": [
          "city",
          "country",
          "temp_c",
          "feels_like_c",
          "humidity_pct",
          "wind_kph",
          "condition",
          "precip_mm"
        ],
        "title": "WeatherResult",
        "type": "object"
      }
    },
    {
      "name": "get_forecast",
      "description": "Get a 3-day forecast for a city.\n\nArgs:\n    city: City key or display name (e.g. 'tokyo', 'Tokyo', 'New York').\n",
      "inputSchema": {
        "properties": {
          "city": {
            "type": "string"
          }
        },
        "required": [
          "city"
        ],
        "type": "object"
      },
      "outputSchema": {
        "$defs": {
          "ForecastDay": {
            "properties": {
              "day": {
                "type": "string"
              },
              "high_c": {
                "type": "number"
              },
              "low_c": {
                "type": "number"
              },
              "condition": {
                "type": "string"
              }
            },
            "required": [
              "day",
              "high_c",
              "low_c",
              "condition"
            ],
            "title": "ForecastDay",
            "type": "object"
          }
        },
        "properties": {
          "result": {
            "items": {
              "$ref": "#/$defs/ForecastDay"
            },
            "type": "array"
          }
        },
        "required": [
          "result"
        ],
        "type": "object"
      }
    },
    {
      "name": "get_air_quality",

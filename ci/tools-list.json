      "outputSchema": {
        "$defs": {
          "WeatherAlert": {
            "properties": {
              "type": {
                "type": "string"
              },
              "severity": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "severity",
              "message"
            ],
            "title": "WeatherAlert",
            "type": "object"
